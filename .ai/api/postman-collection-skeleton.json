      "name": "00 Health / Route Hardening",
      "item": [
        {
          "name": "GET Categories (Expected 501)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/categories",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "categories"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 501\", function () {",
                  "  pm.expect(pm.response.code).to.eql(501);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test(\"Not implemented envelope\", function () {",
                  "  pm.expect(json.success).to.eql(false);",
                  "  pm.expect(json.message).to.eql(\"Feature not implemented\");",
                  "  pm.expect(json).to.have.property(\"errors\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
