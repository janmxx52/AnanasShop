    {
      "name": "02 Product Public",
      "item": [
        {
          "name": "GET Product List (Save product vars)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200\", function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const json = pm.response.json();",
                  "const products = json.data || [];",
                  "pm.test(\"Has at least one product\", function () {",
                  "  pm.expect(products.length).to.be.greaterThan(0);",
                  "});",
                  "if (products.length > 0) {",
                  "  pm.environment.set(\"product_slug\", products[0].slug);",
                  "  pm.environment.set(\"product_id\", String(products[0].id));",
                  "  if (products[0].variants && products[0].variants.length > 0) {",
                  "    pm.environment.set(\"variant_id\", String(products[0].variants[0].id));",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Product Detail",
          "request": {
            "method": "GET",
